{
  "name": "claude-channel-agentpost",
  "version": "0.0.9",
  "description": "Encrypted email channel for AI agents. MCP server over stdio.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "agentpost-mcp": "./dist/server.node.mjs"
  },
  "exports": {
    "./server": "./dist/server.node.mjs"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "bun run build:bun && bun run build:node",
    "build:bun": "bun build server.ts --target=bun --outdir=dist --external libsodium-wrappers-sumo",
    "build:node": "bun build server.ts --target=node --outfile=dist/server.node.mjs --external libsodium-wrappers-sumo --banner '#!/usr/bin/env node'",
    "start": "bun install --no-summary && bun dist/server.js",
    "start:node": "node dist/server.node.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "libsodium-wrappers-sumo": "^0.7.15",
    "postal-mime": "^2.4.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/turndown": "^5.0.6"
  }
}
